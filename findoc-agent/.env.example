# Copy this file to .env and replace placeholder secrets before local use.
# Do not commit .env.

DB_USERNAME=postgres
DB_PASSWORD=postgres
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters-long

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai

LOG_PATH=./logs
LOG_FILE=findoc-agent.log

FINDOC_INGESTION_TOPIC=findoc.ingestion
FINDOC_INGESTION_GROUP=findoc-ingestion
FINDOC_INGESTION_DLQ=findoc.ingestion.dlq